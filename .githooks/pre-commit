#!/bin/bash

# ==============================
# pre-commit
# ==============================

printf "\033[37;1m== pre-commit ==\033[0m\n"

# Get current branch name
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)
readonly BRANCH_NAME

# Exit code: 0 = OK, 1 = NG
code=0

# ------------------------------
# Branch name check
# ------------------------------
printf " - Checking commit target branch name: "

# Prohibited branches
readonly INCORRECT_BRANCHES=("master" "main")

branch_prohibited=0
for prohibited in "${INCORRECT_BRANCHES[@]}"; do
  if [ "$BRANCH_NAME" = "$prohibited" ]; then
    branch_prohibited=1
    break
  fi
done

if [ "${branch_prohibited}" -eq 1 ]; then
  printf "\033[31;22mNG\033[0m\n"
  printf "\033[31;22m================================================================\n"
  printf "Commits to the '%s' branch are prohibited.\n\n" "$BRANCH_NAME"
  printf "Prohibited branches:\n"
  printf "  %s\n" "${INCORRECT_BRANCHES[*]}"
  printf "================================================================\033[0m\n"
  code=1
else
  printf "\033[32;22mOK\033[0m\n"
fi

# ------------------------------
# Detect staged changes
# ------------------------------
# Only staged files are considered.
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
readonly STAGED_FILES

sources_changed=0

# TypeScript:
# - Run the type checker when any source, test or script file is included. There is no
#   build step, so the type checker is the only thing standing between a typo and a
#   worker that dies on its first import.
if echo "$STAGED_FILES" | grep -Eq '\.ts$'; then
  sources_changed=1
fi

# ------------------------------
# TypeScript checks
# ------------------------------
printf " - Checking sources (typecheck): "

if [ "${code}" -eq 0 ]; then
  if [ "${sources_changed}" -eq 1 ]; then
    # The suite is intentionally skipped: it drives real git repositories and takes
    # minutes. CI runs it, and the loop's own merge gate runs it per task.
    if npx tsc --noEmit >/dev/null 2>&1; then
      printf "\033[32;22mOK\033[0m\n"
    else
      printf "\033[31;22mNG\033[0m\n"
      printf "\033[31;22m================================================================\n"
      printf "Type checking failed.\n"
      printf "Run 'npm run typecheck' to see the errors.\n"
      printf "================================================================\033[0m\n"
      code=1
    fi
  else
    printf "\033[33;22mSKIPPED\033[0m\n"
  fi
else
  printf "\033[33;22mSKIPPED\033[0m\n"
fi

# ------------------------------
# Summary
# ------------------------------
if [ "${code}" -eq 0 ]; then
  printf "\n\033[32;1mALL CHECKS PASSED\033[0m\n\n"
else
  printf "\n\033[31;1mpre-commit FAILED\033[0m\n\n"
fi

exit "${code}"
