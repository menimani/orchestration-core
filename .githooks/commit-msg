#!/bin/sh

# ==============================
# commit-msg
# ==============================

printf "\033[37;1m== commit-msg ==\033[0m\n"

COMMIT_MSG_FILE="$1"
readonly COMMIT_MSG_FILE

# Exit code: 0 = OK, 1 = NG
code=0

# ------------------------------
# Commit message prefix check
# ------------------------------
printf " - Checking commit message prefix: "

# Allowed commit types
ALLOWED_TYPES="feat fix chore docs refactor test"
readonly ALLOWED_TYPES

# Read first line of commit message
FIRST_LINE="$(head -n 1 "$COMMIT_MSG_FILE")"

# Skip merge commits
if printf '%s\n' "$FIRST_LINE" | grep -q "^Merge "; then
  printf "\033[33;22mSKIPPED\033[0m\n"
else
  if printf '%s\n' "$FIRST_LINE" \
    | grep -Eq '^(feat|fix|chore|docs|refactor|test): [^ ].*'; then
    printf "\033[32;22mOK\033[0m\n"
  else
    printf "\033[31;22mNG\033[0m\n"
    printf "\033[31;22m================================================================\n"
    printf "Invalid commit message format.\n\n"
    printf "Your commit message:\n"
    printf "  %s\n\n" "$FIRST_LINE"
    printf "Required format:\n"
    printf "  <type>: <subject>\n\n"
    printf "Rules:\n"
    printf "  - Allowed types only\n"
    printf "  - Exactly ONE space after ':'\n"
    printf "  - Subject must not start with a space\n\n"
    printf "Allowed types:\n"
    printf "  %s\n" "${ALLOWED_TYPES}"
    printf "\nExample:\n"
    printf "  feat: add login feature\n"
    printf "================================================================\033[0m\n"
    code=1
  fi
fi

# ------------------------------
# Summary
# ------------------------------
if [ "${code}" -eq 0 ]; then
  printf "\n\033[32;1mALL CHECKS PASSED\033[0m\n\n"
else
  printf "\n\033[31;1mcommit-msg FAILED\033[0m\n\n"
fi

exit "${code}"
